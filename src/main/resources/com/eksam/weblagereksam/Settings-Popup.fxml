<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="480" spacing="12" styleClass="cBoarder, settings-panel" stylesheets="@Overall.css, @Light-mode.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eksam.weblagereksam.GUI.Util.SettingsPopupController">
    <padding>
        <Insets bottom="18" left="18" right="18" top="18" />
    </padding>
    <children>
        <Label styleClass="settings-title" text="Settings" />
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="settings-theme-row">
            <Label styleClass="settings-theme-icon" text="Theme" />
            <HBox fx:id="themeSwitchTrack" alignment="CENTER" onMouseClicked="#handleDarkModeChanged" styleClass="theme-switch">
                <Label fx:id="labelSwitchLight" alignment="CENTER" maxWidth="Infinity" styleClass="theme-switch-option" text="Light" HBox.hgrow="ALWAYS" />
                <Label fx:id="labelSwitchDark" alignment="CENTER" maxWidth="Infinity" styleClass="theme-switch-option" text="Dark" HBox.hgrow="ALWAYS" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="labelThemeMode" styleClass="settings-theme-mode" text="Light mode" />
        </HBox>
        <TitledPane expanded="true" text="Keyboard shortcuts">
            <content>
                <ScrollPane fitToWidth="true" prefHeight="330" styleClass="settings-shortcut-scroll">
                    <VBox fx:id="shortcutsBox" spacing="7" styleClass="settings-shortcut-list" />
                </ScrollPane>
            </content>
        </TitledPane>
        <HBox spacing="8" styleClass="settings-footer">
            <Button onAction="#handleLogout" styleClass="btn-destructive" text="Logout" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnClose" onAction="#handleClose" styleClass="btn-secondary" text="Close" />
        </HBox>
    </children>
</VBox>
