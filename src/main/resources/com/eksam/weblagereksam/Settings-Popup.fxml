<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="520" spacing="16" styleClass="cBoarder, settings-panel" stylesheets="@Overall.css, @Light-mode.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eksam.weblagereksam.GUI.Util.SettingsPopupController">
    <padding>
        <Insets bottom="14" left="14" right="14" top="14" />
    </padding>
    <children>
        <Label styleClass="settings-title" text="Settings" />
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="settings-theme-row">
            <Label styleClass="settings-theme-icon" text="Light" />
            <Button fx:id="btnThemeSwitch" onAction="#handleDarkModeChanged" styleClass="theme-switch" text="Light" />
            <Label styleClass="settings-theme-icon" text="Dark" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="labelThemeMode" styleClass="settings-theme-mode" text="Light mode" />
        </HBox>
        <TitledPane expanded="true" text="Keyboard shortcuts">
            <content>
                <ScrollPane fitToWidth="true" prefHeight="360" styleClass="settings-shortcut-scroll">
                    <VBox fx:id="shortcutsBox" spacing="7" styleClass="settings-shortcut-list" />
                </ScrollPane>
            </content>
        </TitledPane>
        <HBox spacing="8" styleClass="settings-footer">
            <Button onAction="#handleLogout" styleClass="btn-destructive" text="Logout" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnClose" onAction="#handleClose" styleClass="btn-secondary" text="Close" />
        </HBox>
    </children>
</VBox>
