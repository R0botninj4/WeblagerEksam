<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="360" spacing="10" styleClass="cBoarder" stylesheets="@Overall.css, @Light-mode.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eksam.weblagereksam.GUI.Scanning.MyBoxesPopupController">
    <padding>
        <Insets bottom="14" left="14" right="14" top="14" />
    </padding>
    <children>
        <Label styleClass="top-bar-title" text="My boxes" />
        <ComboBox fx:id="comboSavedBoxes" maxWidth="Infinity" promptText="Saved boxes" />
        <Button maxWidth="Infinity" onAction="#openSaved" styleClass="btn-secondary" text="Open saved" />
        <HBox spacing="8">
            <Button maxWidth="Infinity" onAction="#markDone" styleClass="btn-primary" text="Done" HBox.hgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#removeBox" styleClass="btn-destructive" text="Remove" HBox.hgrow="ALWAYS" />
        </HBox>

        <Separator />
        <Label styleClass="sidebar-export-title" text="Export" />
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label styleClass="sidebar-export-value" text="Output" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="labelOutputName" styleClass="sidebar-export-value" text="No box" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label styleClass="sidebar-export-value" text="Format" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="labelFormat" styleClass="sidebar-export-value" text="TIFF Multi-page" />
        </HBox>
        <HBox spacing="0">
            <Button fx:id="btnMultiPage" maxWidth="Infinity" onAction="#useMultiPage" styleClass="btn-format" text="Multi-page" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnSinglePage" maxWidth="Infinity" onAction="#useSinglePage" styleClass="btn-format" text="Single-page" HBox.hgrow="ALWAYS" />
        </HBox>
        <Button fx:id="btnExport" maxWidth="Infinity" onAction="#exportBox" styleClass="btn-primary" text="Export" />
    </children>
</VBox>
