<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="scanRoot" prefHeight="800" prefWidth="1280" stylesheets="@Overall.css, @Light-mode.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eksam.weblagereksam.GUI.Scanning.UserScanningController">

    <top>
        <VBox>
            <HBox prefHeight="49.0" prefWidth="1280.0" styleClass="top-bar" BorderPane.alignment="CENTER">
                <Label styleClass="top-bar-title" text="Weblager" />
                <Region prefHeight="50.0" prefWidth="1016.0" HBox.hgrow="ALWAYS" />
                <Label fx:id="labelUser" styleClass="top-bar-username" text="Username" />
                <Button fx:id="btnLogout" onAction="#handleLogout" styleClass="btn-secondary" text="Logout" />
            </HBox>
            <HBox spacing="18" styleClass="scan-info-bar">
                <Button fx:id="btnStartScan" onAction="#handleStartScan" styleClass="btn-secondary" text="Start scan" />
                <Button fx:id="btnMyBoxes" onAction="#handleMyBoxes" styleClass="btn-secondary" text="My boxes" />
            <Separator orientation="VERTICAL" prefHeight="0.0" prefWidth="1.0" />
                <Label fx:id="labelClient" styleClass="scan-info-label" text="Client: No client" />
            <Separator orientation="VERTICAL" prefHeight="0.0" prefWidth="0.0" />
                <Label fx:id="labelProfile" contentDisplay="CENTER" styleClass="scan-info-label" text="Profile: No profile" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="labelFilesCount" styleClass="top-bar-label top-bar-count" text="Files 0" />
                <Separator orientation="VERTICAL" />
                <Label fx:id="labelDocsCount" styleClass="top-bar-label top-bar-count" text="Docs 0" />
                <Separator orientation="VERTICAL" />
                <Button fx:id="btnThemeToggle" onAction="#handleThemeToggle" styleClass="btn-secondary" text="Light mode" />
                <Separator orientation="VERTICAL" />
                <Label fx:id="labelConnected" styleClass="scan-info-label" text="Connected" />
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox prefWidth="220" spacing="0" styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="sidebar-section-header">
                <Label styleClass="h3" text="DOCUMENTS" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="labelDocCount" styleClass="sidebar-section-count" text="0 docs" />
            </HBox>
            <ScrollPane fx:id="documentsScrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="filmstrip-scroll" VBox.vgrow="ALWAYS">
                <TreeView fx:id="documentTreeView" maxWidth="Infinity" showRoot="false" styleClass="document-tree" />
            </ScrollPane>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <BorderPane>
                <top>
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="image-action-bar">

                        <Button fx:id="btnRotateCCW" onAction="#handleRotateLeft" styleClass="btn-secondary" text="Left">
                            <graphic>
                                <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../Icons/icon_rotate_left.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <Button fx:id="btnRotateCW" onAction="#handleRotateRight" styleClass="btn-secondary" text="Right">
                            <graphic>
                                <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../Icons/icon_rotate_right.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <Label styleClass="top-bar-label" text="Rotation" />
                        <ComboBox fx:id="comboRotationDegrees" editable="true" onAction="#handleRotationSelected" prefWidth="90" promptText="Degrees" styleClass="combo-box" />

                        <Button fx:id="btnDeletePage" onAction="#deleteCurrentPage" styleClass="btn-destructive" text="Delete">
                            <graphic>
                                <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../Icons/icon_delete.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnPrev" onAction="#showPreviousPage" styleClass="btn-secondary" text="Previous" />
                        <Label fx:id="labelPagePosition" styleClass="image-page-position" text="0 / 0" />
                        <Button fx:id="btnNext" onAction="#showNextPage" styleClass="btn-secondary" text="Next" />
                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>
                </top>

                <center>
                    <BorderPane styleClass="image-viewer-bg">
                        <left>
                            <Button fx:id="btnNavLeft" onAction="#showPreviousPage" styleClass="btn-icon" text="&lt;" BorderPane.alignment="CENTER">
                                <BorderPane.margin>
                                    <Insets left="12" />
                                </BorderPane.margin>
                            </Button>
                        </left>

                        <right>
                            <Button fx:id="btnNavRight" onAction="#showNextPage" styleClass="btn-icon" text="&gt;" BorderPane.alignment="CENTER">
                                <BorderPane.margin>
                                    <Insets right="12" />
                                </BorderPane.margin>
                            </Button>
                        </right>

                        <center>
                            <StackPane fx:id="imageViewerPane" BorderPane.alignment="CENTER">
                                <VBox alignment="CENTER" maxHeight="680" maxWidth="500" styleClass="image-card" StackPane.alignment="CENTER">
                                    <ImageView fx:id="pageImageView" fitHeight="640" fitWidth="480" preserveRatio="true" />
                                </VBox>

                                <Label fx:id="labelPageRef" styleClass="image-page-ref" text="No page selected" StackPane.alignment="BOTTOM_CENTER">
                                    <StackPane.margin>
                                        <Insets bottom="20" />
                                    </StackPane.margin>
                                </Label>
                            </StackPane>
                        </center>
                    </BorderPane>
                </center>

                <bottom>
                    <BorderPane styleClass="filmstrip-bar">
                        <center>
                            <ScrollPane fx:id="filmstripScrollPane" fitToHeight="true" hbarPolicy="ALWAYS" styleClass="filmstrip-scroll" vbarPolicy="NEVER">
                                <HBox fx:id="filmstripBox" alignment="CENTER_LEFT" spacing="4" styleClass="filmstrip-container" />
                            </ScrollPane>
                        </center>

                        <right>
                            <VBox spacing="8" BorderPane.alignment="CENTER">
                                <BorderPane.margin>
                                    <Insets left="8" />
                                </BorderPane.margin>
                                <Button fx:id="btnFetchNext" maxWidth="Infinity" onAction="#handleFetchNext" styleClass="btn-fetch" text="Fetch next" />
                                <Button fx:id="btnFetchTen" maxWidth="Infinity" onAction="#handleFetchTen" styleClass="btn-fetch" text="Fetch 10" />
                            </VBox>
                        </right>
                    </BorderPane>
                </bottom>
            </BorderPane>
         <BorderPane.margin>
            <Insets left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="status-bar">
            <Label fx:id="labelRotationInfo" styleClass="status-bar" text="Rotation: 0 degrees" />
            <Label fx:id="labelShortcuts" styleClass="status-bar" text="Shortcuts: Arrows=navigate  R=rotate  Del=delete" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="labelStatusUser" styleClass="status-bar" text="Username - Archive name" />
        </HBox>
    </bottom>
</BorderPane>
