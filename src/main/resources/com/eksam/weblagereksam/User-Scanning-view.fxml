<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.image.Image?>
<BorderPane fx:id="scanRoot" prefHeight="800" prefWidth="1280" stylesheets="@Overall.css, @Dark-mode.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eksam.weblagereksam.GUI.UserScanningController">

    <top>
        <HBox styleClass="top-bar" BorderPane.alignment="CENTER">
            <Label styleClass="top-bar-title" text="Weblager" />
            <Separator orientation="VERTICAL" />
            <Label styleClass="top-bar-label" text="Box" />
            <ComboBox fx:id="comboBoxBoxes" onAction="#handleBoxSelected" prefWidth="190" />
            <Label styleClass="top-bar-label" text="Profile" />
            <Label fx:id="labelProfile" styleClass="top-bar-label" text="Archive: Name" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="labelFilesCount" styleClass="top-bar-label" text="Files 0" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="labelDocsCount" styleClass="top-bar-label" text="Docs 0" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="labelSessionTimer" styleClass="top-bar-label" text="00:00" />
            <Separator orientation="VERTICAL" />
            <Button fx:id="btnThemeToggle" onAction="#handleThemeToggle" styleClass="btn-secondary" text="Light mode" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="labelUser" styleClass="top-bar-username" text="Username" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="220" spacing="0" styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="sidebar-section-header">
                <Label styleClass="h3" text="DOCUMENTS" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="labelDocCount" styleClass="sidebar-section-count" text="0 docs" />
            </HBox>

            <ScrollPane fx:id="documentsScrollPane" fitToWidth="true" styleClass="filmstrip-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="documentsContainer" spacing="6" style="-fx-padding: 8;" />
            </ScrollPane>

            <VBox spacing="8" styleClass="sidebar-export-section">
                <Label styleClass="sidebar-export-title" text="EXPORT" />
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label styleClass="sidebar-export-value" text="Output" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="labelOutputName" styleClass="sidebar-export-value" text="No Box" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label styleClass="sidebar-export-value" text="Format" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="labelFormat" styleClass="sidebar-export-value" text="TIFF Multi-page" />
                </HBox>
                <HBox spacing="0">
                    <Button fx:id="btnMultiPage" maxWidth="Infinity" onAction="#handleMultiPageFormat" styleClass="btn-format" text="Multi-page" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnSinglePage" maxWidth="Infinity" onAction="#handleSinglePageFormat" styleClass="btn-format" text="Single-page" HBox.hgrow="ALWAYS" />
                </HBox>
                <Button fx:id="btnExport" maxWidth="Infinity" onAction="#handleExport" styleClass="btn-primary" text="Export (0 documents)" />
            </VBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <BorderPane>
                <top>
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="image-action-bar">

                        <Button fx:id="btnRotateCCW" onAction="#handleRotateLeft" styleClass="btn-secondary" text="">
                            <graphic>
                                <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../Icons/icon_edit.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <Button fx:id="btnRotateCW" onAction="#handleRotateRight" styleClass="btn-secondary" text="">
                            <graphic>
                                <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../Icons/icon_print.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <Button fx:id="btnDelete" onAction="#deleteCurrentPage" styleClass="btn-destructive" text="Delete" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnPrev" onAction="#showPreviousPage" styleClass="btn-secondary" text="Previous" />
                        <Label fx:id="labelPagePosition" styleClass="image-page-position" text="0 / 0" />
                        <Button fx:id="btnNext" onAction="#showNextPage" styleClass="btn-secondary" text="Next" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnSlideshow" onAction="#handleSlideshow" styleClass="btn-secondary" text="Slideshow" />
                    </HBox>
                </top>

                <center>
                    <BorderPane styleClass="image-viewer-bg">
                        <left>
                            <Button fx:id="btnNavLeft" onAction="#showPreviousPage" styleClass="btn-icon" text="&lt;" BorderPane.alignment="CENTER">
                                <BorderPane.margin>
                                    <Insets left="12" />
                                </BorderPane.margin>
                            </Button>
                        </left>

                        <right>
                            <Button fx:id="btnNavRight" onAction="#showNextPage" styleClass="btn-icon" text="&gt;" BorderPane.alignment="CENTER">
                                <BorderPane.margin>
                                    <Insets right="12" />
                                </BorderPane.margin>
                            </Button>
                        </right>

                        <center>
                            <StackPane BorderPane.alignment="CENTER">
                                <VBox alignment="CENTER" maxHeight="680" maxWidth="500" styleClass="image-card" StackPane.alignment="CENTER">
                                    <ImageView fx:id="pageImageView" fitHeight="640" fitWidth="480" preserveRatio="true" />
                                </VBox>

                                <Label fx:id="labelPageRef" styleClass="image-page-ref" text="No page selected" StackPane.alignment="BOTTOM_CENTER">
                                    <StackPane.margin>
                                        <Insets bottom="20" />
                                    </StackPane.margin>
                                </Label>
                            </StackPane>
                        </center>
                    </BorderPane>
                </center>

                <bottom>
                    <BorderPane styleClass="filmstrip-bar">
                        <center>
                            <ScrollPane fx:id="filmstripScrollPane" fitToHeight="true" hbarPolicy="ALWAYS" styleClass="filmstrip-scroll" vbarPolicy="NEVER">
                                <HBox fx:id="filmstripBox" alignment="CENTER_LEFT" spacing="4" styleClass="filmstrip-container" />
                            </ScrollPane>
                        </center>

                        <right>
                            <VBox spacing="8" BorderPane.alignment="CENTER">
                                <BorderPane.margin>
                                    <Insets left="8" />
                                </BorderPane.margin>
                                <Button fx:id="btnFetchNext" maxWidth="Infinity" onAction="#handleFetchNext" styleClass="btn-fetch" text="Fetch next" />
                                <Button fx:id="btnFetchTen" maxWidth="Infinity" onAction="#handleFetchTen" styleClass="btn-fetch" text="Fetch 10" />
                            </VBox>
                        </right>
                    </BorderPane>
                </bottom>
            </BorderPane>
         <BorderPane.margin>
            <Insets left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="status-bar">
            <Label fx:id="labelConnected" styleClass="status-bar" text="Connected" />
            <Label fx:id="labelRotationInfo" styleClass="status-bar" text="Rotation: 0 degrees" />
            <Label fx:id="labelShortcuts" styleClass="status-bar" text="Shortcuts: Arrows=navigate  R=rotate  Del=delete" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="labelStatusUser" styleClass="status-bar" text="Username - Archive name" />
        </HBox>
    </bottom>
</BorderPane>
