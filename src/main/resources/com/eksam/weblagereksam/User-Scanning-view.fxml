<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800" prefWidth="1280"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eksam.weblagereksam.GUI.UserScanningController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 8 16 8 16; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
            <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Weblager" />
            <Separator orientation="VERTICAL" />
            <Label text="Box" />
            <ComboBox fx:id="comboBoxBoxes" onAction="#handleBoxSelected" prefWidth="190" />
            <Label text="Profile" />
            <Label fx:id="labelProfile" text="Archive: Name" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="labelFilesCount" text="Files 0" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="labelDocsCount" text="Docs 0" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="labelSessionTimer" text="00:00" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="labelUser" style="-fx-font-weight: bold;" text="Username" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="220" spacing="0" style="-fx-border-color: #cccccc; -fx-border-width: 0 1 0 0;">
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 8 12 8 12; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
                <Label style="-fx-font-weight: bold;" text="DOCUMENTS" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="labelDocCount" text="0 docs" />
            </HBox>

            <ScrollPane fx:id="documentsScrollPane" fitToWidth="true" style="-fx-border-width: 0;" VBox.vgrow="ALWAYS">
                <VBox fx:id="documentsContainer" spacing="6" style="-fx-padding: 8;" />
            </ScrollPane>

            <VBox spacing="8" style="-fx-padding: 12; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;">
                <Label style="-fx-font-weight: bold;" text="EXPORT" />
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Output" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="labelOutputName" text="No Box" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Format" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="labelFormat" text="TIFF Multi-page" />
                </HBox>
                <HBox spacing="0">
                    <Button fx:id="btnMultiPage" maxWidth="Infinity" onAction="#handleMultiPageFormat" text="Multi-page" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnSinglePage" maxWidth="Infinity" onAction="#handleSinglePageFormat" text="Single-page" HBox.hgrow="ALWAYS" />
                </HBox>
                <Button fx:id="btnExport" maxWidth="Infinity" onAction="#handleExport" text="Export (0 documents)" />
            </VBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <BorderPane>
                <top>
                    <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 8 16 8 16; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
                        <Button fx:id="btnRotateCCW" onAction="#handleRotateLeft" text="Rotate left" />
                        <Button fx:id="btnRotateCW" onAction="#handleRotateRight" text="Rotate right" />
                        <Button fx:id="btnDelete" onAction="#deleteCurrentPage" text="Delete" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnPrev" onAction="#showPreviousPage" text="Previous" />
                        <Label fx:id="labelPagePosition" style="-fx-padding: 0 8 0 8;" text="0 / 0" />
                        <Button fx:id="btnNext" onAction="#showNextPage" text="Next" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnSlideshow" onAction="#handleSlideshow" text="Slideshow" />
                    </HBox>
                </top>

                <center>
                    <BorderPane style="-fx-background-color: #e0e0e0;">
                        <left>
                            <Button fx:id="btnNavLeft" onAction="#showPreviousPage" style="-fx-font-size: 18;" text="&lt;" BorderPane.alignment="CENTER">
                                <BorderPane.margin>
                                    <Insets left="12" />
                                </BorderPane.margin>
                            </Button>
                        </left>

                        <right>
                            <Button fx:id="btnNavRight" onAction="#showNextPage" style="-fx-font-size: 18;" text="&gt;" BorderPane.alignment="CENTER">
                                <BorderPane.margin>
                                    <Insets right="12" />
                                </BorderPane.margin>
                            </Button>
                        </right>

                        <center>
                            <StackPane BorderPane.alignment="CENTER">
                                <VBox alignment="CENTER"
                                      maxHeight="680"
                                      maxWidth="500"
                                      style="-fx-background-color: white; -fx-border-color: #bbbbbb; -fx-border-width: 1;"
                                      StackPane.alignment="CENTER">
                                    <ImageView fx:id="pageImageView"
                                               fitHeight="640"
                                               fitWidth="480"
                                               preserveRatio="true" />
                                </VBox>

                                <Label fx:id="labelPageRef"
                                       style="-fx-background-color: rgba(0,0,0,0.5); -fx-text-fill: white; -fx-padding: 3 8 3 8;"
                                       text="No page selected"
                                       StackPane.alignment="BOTTOM_CENTER">
                                    <StackPane.margin>
                                        <Insets bottom="20" />
                                    </StackPane.margin>
                                </Label>
                            </StackPane>
                        </center>
                    </BorderPane>
                </center>

                <bottom>
                    <BorderPane style="-fx-border-color: #cccccc; -fx-border-width: 1 0 0 0; -fx-padding: 6; -fx-background-color: #f5f5f5;">
                        <center>
                            <ScrollPane fx:id="filmstripScrollPane"
                                        fitToHeight="true"
                                        hbarPolicy="ALWAYS"
                                        style="-fx-border-width: 0; -fx-background: transparent;"
                                        vbarPolicy="NEVER">
                                <HBox fx:id="filmstripBox" alignment="CENTER_LEFT" spacing="4" style="-fx-padding: 4;" />
                            </ScrollPane>
                        </center>

                        <right>
                            <VBox spacing="8" BorderPane.alignment="CENTER">
                                <BorderPane.margin>
                                    <Insets left="8" />
                                </BorderPane.margin>
                                <Button fx:id="btnFetchNext" maxWidth="Infinity" onAction="#handleFetchNext" text="Fetch next" />
                                <Button fx:id="btnFetchTen" maxWidth="Infinity" onAction="#handleFetchTen" text="Fetch 10" />
                            </VBox>
                        </right>
                    </BorderPane>
                </bottom>
            </BorderPane>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 4 16 4 16; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;">
            <Label fx:id="labelConnected" text="Connected" />
            <Label fx:id="labelRotationInfo" text="Rotation: 0 degrees" />
            <Label fx:id="labelShortcuts" text="Shortcuts: Arrows=navigate  R=rotate  Del=delete" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="labelStatusUser" text="Username - Archive name" />
        </HBox>
    </bottom>
</BorderPane>
