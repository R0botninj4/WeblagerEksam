<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="360" spacing="12" styleClass="cBoarder" stylesheets="@Overall.css, @Light-mode.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eksam.weblagereksam.GUI.Admin.AdminUserPopupController">
    <padding>
        <Insets bottom="18" left="18" right="18" top="18" />
    </padding>
    <children>
        <Label fx:id="labelTitle" styleClass="h3" text="User creation" />
        <TextField fx:id="txtUsername" promptText="Username" styleClass="search-field" />
        <TextField fx:id="txtPassword" promptText="Password" styleClass="search-field" />
        <ComboBox fx:id="comboRole" maxWidth="Infinity" promptText="Role" styleClass="combo-box" />
        <CheckBox fx:id="checkActive" selected="true" text="Active user" />
        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#save" styleClass="btn-primary" text="Add">
            <VBox.margin>
                <Insets top="6.0" />
            </VBox.margin>
        </Button>
    </children>
</VBox>
